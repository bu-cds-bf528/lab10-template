//Use the params to define reference files, directories, and CLI options
params {

    // compute_matrix.nf: one row per genome, columns `name`, `bigwig`
    // (UCSC gc5Base track), `gtf` (refGene annotation for the same assembly).
    // Regions are the GTF's unique NM transcripts. computeMatrix scale-regions
    // is run for every bin size x body length; body length `species` = that
    // genome's median transcript length, `shared` = the median of
    // `matrix_shared_median_genome` for every genome
    gc5base_tracks = "${projectDir}/gc5base_tracks.csv"
    matrix_bin_sizes = [5, 50, 500]
    matrix_body_lengths = ['species', 'shared']
    matrix_shared_median_genome = 'mm10'
    // -b / -a flank per genome (must be divisible by every bin size)
    matrix_flank = [mm10: 3000, dm6: 1000]

    // bam_to_bigwig.nf: one row per alignment, columns `name`, `bam`; each BAM
    // is sorted, indexed and converted to a bigWig with bamCoverage
    bams = "${projectDir}/bams.csv"
    // Strategies from the DEEPTOOLS_BAMCOVERAGE block below; one bigWig is
    // made per sample per strategy (<sample>.<strategy>.bw)
    coverage_variants = ['raw', 'globalmax', 'windowmax', 'cpm']
    // Maximum raw coverage per sample: on all of chr19 (global) and in the
    // figure's window (window)
    globalmax = [atacseq_50k_chr19: 2029, dnaseseq_chr19: 2136, faireseq_chr19: 2160]
    windowmax = [atacseq_50k_chr19: 58, dnaseseq_chr19: 172, faireseq_chr19: 15]

    outdir = "${projectDir}/results"
}

outputDir = params.outdir

process {

    // bamCoverage options for each strategy; each sample's variant picks one.
    // To add a strategy, add an entry here and its name to
    // params.coverage_variants. Useful pieces:
    //   '--normalizeUsing CPM'
    //   "--scaleFactor ${1 / 100}"          divides coverage by 100
    //   params.globalmax[sample.name]       this sample's max on chr19
    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        ext.args = {
            [
                raw:       '',
                globalmax: "--scaleFactor ${1 / params.globalmax[sample.name]}",
                windowmax: "--scaleFactor ${1 / params.windowmax[sample.name]}",
                cpm:       '--normalizeUsing CPM',
            ][sample.variant]
        }
    }

    // computeMatrix scale-regions options per sweep: bin size, -m from
    // either this genome's median transcript length or the shared genome's,
    // and the genome's fixed -b / -a flank
    withName: 'DEEPTOOLS_COMPUTEMATRIX_SCALEREGIONS' {
        ext.args = {
            def body_length = [
                species: sweep.species_median,
                shared:  sweep.shared_median,
            ][sweep.body_length]
            def flank = params.matrix_flank[sweep.genome]
            "--binSize ${sweep.bin_size} --regionBodyLength ${body_length} " +
                "--beforeRegionStartLength ${flank} --afterRegionStartLength ${flank}"
        }
    }

    withName: 'DEEPTOOLS_PLOTHEATMAP_MATRIX' {
        ext.args = '--colorMap viridis'
    }
}

profiles {

    // When you invoke multiple options (e.g. -profile conda,cluster) - all of the options are
    // automatically applied by nextflow

    // When you invoke -profile conda - processes use the environments in envs/
    conda {
        conda.enabled = true
    }

    // When you invoke -profile singularity - nextflow automatically applies these options
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    // When you invoke -profile cluster - nextflow automatically applies these options
    cluster {
        process {
                executor = 'sge'
                clusterOptions = '-P bf528'
                penv = 'omp'

                withLabel: process_single {
                    cpus = 1
                }

                withLabel: process_medium {
                    cpus = 8
                }
        }
    }

    local {
        process.executor = 'local'
    }
}

//Change the queueSize to enable more parallel jobs (remember the SCC is a shared resource)
executor {
    $sge {
        queueSize = 20
    }
    $local {
        cpus = 1
    }
}

//Miscellaneous CLI flags
resume = true
